# Local Docker Postgres (see docker-compose.yml — host port 55432)
# When Neon is ready, replace with your Neon connection string:
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://portfolio:portfolio@127.0.0.1:55432/portfolio

AUTH_SECRET=generate-with-openssl-rand-hex-32
# Production must be the public https origin (required for secure session cookies)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

ADMIN_EMAIL=admin@ryantang.site
ADMIN_PASSWORD=changeme
# Optional: precomputed bcrypt hash instead of ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=

# Resend (outbound + inbound webhook)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@ryantang.site
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=ryantang.site

# Vercel Blob (optional in local; falls back to /uploads)
BLOB_READ_WRITE_TOKEN=

# PayPal (sandbox first)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Contract PDF PAdES sealing (optional locally)
AGREEMENT_SIGNING_ENABLED=false
AGREEMENT_SIGNING_P12_BASE64=
AGREEMENT_SIGNING_P12_PASSPHRASE=
